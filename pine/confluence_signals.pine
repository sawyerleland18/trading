// (c) confluence-signal-system
//@version=5

// =============================================================================
// CONFLUENCE SIGNAL SYSTEM - Multi-Factor Buy/Sell Engine
// -----------------------------------------------------------------------------
// A rule-based, explainable "net score" (-100..+100) built from six weighted
// factor groups (Trend, Momentum, Volume, Volatility Regime, Mean-Reversion,
// and Long-Term Regime). Crossing the score above/below configurable
// thresholds generates buy/sell signals, drives an optional strategy
// backtest (Strategy Tester stats, equity curve, win rate, profit factor),
// and fires alerts (both classic alertcondition() and dynamic alert()
// calls suitable for webhook bots).
//
// The Long-Term Regime factor is deliberately built from two of the most
// heavily-published, out-of-sample-replicated rules in empirical finance,
// rather than another discretionary technical rule:
//   - 200-day SMA trend timing (Faber, "A Quantitative Approach to
//     Tactical Asset Allocation", 2007/2013) - tested back to 1901 across
//     US equities, foreign equities, bonds, commodities and REITs.
//   - 12-1 month time-series momentum (Jegadeesh & Titman 1993; Moskowitz,
//     Ooi & Pedersen 2012, "Time Series Momentum", Journal of Financial
//     Economics - 58 futures markets across 25+ years; replicated across
//     8 asset classes/markets over more than a century by Asness,
//     Moskowitz & Pedersen 2013, and over 212 years by Geczy & Samonov
//     2016). It carries the single largest weight of any factor group on
//     purpose, because it has the deepest evidence base behind it.
//
// This script is mirrored 1:1 (same weights, same rules) by the Python
// package in python/confluence/ so the exact same logic can be backtested
// across hundreds of tickers and years of history outside TradingView.
// See docs/ARCHITECTURE.md for the full scoring breakdown and citations.
// =============================================================================

// slippage is in ticks (Pine has no percentage-slippage option), applied by
// the platform to every strategy.entry()/strategy.exit() fill automatically -
// the equivalent lever to the Python backtest's slippage_pct param, though
// the two aren't directly comparable (ticks vs. percent) since tick value
// differs per instrument. 5 ticks is a deliberately more conservative
// default than TradingView's usual default of 0-1, after real-data testing
// (docs/BACKTEST_RESULTS.md) showed the strategy's edge is thin enough that
// unrealistically clean fills were flattering the numbers.
strategy("Confluence Signal System - Buy/Sell Engine", shorttitle = "CSS", overlay = true, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 5, pyramiding = 0, calc_on_every_tick = false, max_bars_back = 600)

// ------------------------------- INPUTS -------------------------------------
grpTrend = "Trend (weight 20)"
emaFastLen  = input.int(20,  "Fast EMA",   minval = 2, group = grpTrend)
emaMidLen   = input.int(50,  "Mid EMA",    minval = 2, group = grpTrend)
emaSlowLen  = input.int(200, "Slow EMA",   minval = 2, group = grpTrend)

grpMom = "Momentum (weight 20)"
rsiLen      = input.int(14, "RSI Length", minval = 2, group = grpMom)
macdFast    = input.int(12, "MACD Fast",  group = grpMom)
macdSlow    = input.int(26, "MACD Slow",  group = grpMom)
macdSignal  = input.int(9,  "MACD Signal", group = grpMom)

grpVol = "Volume (weight 15)"
obvLookback = input.int(5,  "OBV Rising Lookback", minval = 1, group = grpVol)
relVolLen   = input.int(20, "Relative Volume SMA", minval = 2, group = grpVol)
relVolMult  = input.float(1.2, "Relative Volume Spike Multiplier", minval = 1.0, step = 0.1, group = grpVol)

grpVola = "Volatility Regime - ADX (weight 10)"
adxLen      = input.int(14, "ADX/DI Length", minval = 2, group = grpVola)
adxThresh   = input.float(20, "ADX Trending Threshold", minval = 5, group = grpVola)

grpBB = "Mean-Reversion - Bollinger (weight 10)"
bbLen       = input.int(20, "BB Length", minval = 5, group = grpBB)
bbMult      = input.float(2.0, "BB StdDev Mult", minval = 0.5, step = 0.1, group = grpBB)

grpLT = "Long-Term Regime - SMA200 Timing + 12-1mo Momentum (weight 25)"
ltSmaLen        = input.int(200, "Long-Term SMA Length", minval = 20, group = grpLT)
momLookbackBars = input.int(252, "Momentum Lookback (bars, ~12 months)", minval = 20, group = grpLT)
momSkipBars     = input.int(21,  "Momentum Skip-Recent (bars, ~1 month)", minval = 0, group = grpLT)

grpSig = "Signal Thresholds"
buyThreshold    = input.int(40,  "Buy Threshold",          group = grpSig)
sellThreshold   = input.int(-40, "Sell Threshold",         group = grpSig)
strongBuyLevel  = input.int(70,  "Strong Buy Label Level", group = grpSig)
strongSellLevel = input.int(-70, "Strong Sell Label Level", group = grpSig)
exitLongScore   = input.int(10,  "Exit Long when score falls below",  group = grpSig)
exitShortScore  = input.int(-10, "Exit Short when score rises above", group = grpSig)

grpTrigger = "Signal Trigger"
triggerMode     = input.string("EMA Crossover + Confluence", "Trigger Mode", options = ["EMA Crossover + Confluence", "Confluence Score Threshold Only"], group = grpTrigger)
emaCrossPair    = input.string("Fast/Mid", "EMA Crossover Pair", options = ["Fast/Mid", "Fast/Slow", "Mid/Slow"], group = grpTrigger)
emaConfirmScore = input.int(15, "Min Abs Net Score to Confirm EMA Crossover", minval = 0, group = grpTrigger)

grpHTF = "Multi-Timeframe Filter"
useHtfFilter = input.bool(true, "Require Higher-Timeframe Trend Alignment", group = grpHTF)
htfTF        = input.timeframe("240", "Higher Timeframe", group = grpHTF)

grpRegime = "Long-Term Regime Filter"
useRegimeFilter = input.bool(true, "Veto Counter-Trend Entries (SMA200 + 12-1mo Momentum)", group = grpRegime)

grpChop = "Chop Filter"
// Defaults OFF, unlike useRegimeFilter above - real-data testing across a
// 10-ticker watchlist (docs/BACKTEST_RESULTS.md) found this filter helped
// SPY specifically (higher Sharpe, much smaller drawdown) but made the
// cross-sectional aggregate WORSE (median Sharpe went negative, only 40% of
// tickers stayed profitable) with the single fixed adxThresh=20 used here.
// Worth testing on a specific ticker before relying on it; not a blanket win.
useChopFilter = input.bool(false, "Veto Any New Entry When ADX Says Market Isn't Trending", group = grpChop)

grpBreadth = "Market Breadth Filter"
// Defaults ON - real-data testing across the 10-ticker watchlist
// (docs/BACKTEST_RESULTS.md) validated this as a broad-based improvement
// (8/10 tickers improved, not concentrated in one or two names like the
// chop filter was): median CAGR 0.37%->0.53%, median Sharpe 0.21->0.34,
// vs. no filters at all - actually the single best-performing individual
// filter tested so far. Distinct from the Long-Term Regime filter above:
// that one looks at the TRADED ticker's own 200-SMA trend; this one looks
// at a separate reference ticker (SPY by default) - don't short an
// individual name just because its own chart looks weak if the broad
// market itself is still in an uptrend, and vice versa.
useBreadthFilter = input.bool(true, "Veto Entries Against Market Breadth (Reference Ticker's Own 200-SMA Trend)", group = grpBreadth)
breadthSymbol     = input.symbol("SPY", "Breadth Reference Symbol", group = grpBreadth)

grpRisk = "Risk Management"
enableLong    = input.bool(true, "Enable Long Trades",  group = grpRisk)
enableShort   = input.bool(true, "Enable Short Trades", group = grpRisk)
atrLen        = input.int(14, "ATR Length", minval = 2, group = grpRisk)
atrMultSL     = input.float(1.5, "ATR Stop-Loss Multiplier",   minval = 0.5, step = 0.1, group = grpRisk)
atrMultTP     = input.float(3.0, "ATR Take-Profit Multiplier", minval = 0.5, step = 0.1, group = grpRisk)
riskPerTrade  = input.float(1.0, "Risk per Trade (% of equity)", minval = 0.1, step = 0.1, group = grpRisk)
// Defaults ON - real-data testing across the 10-ticker watchlist
// (docs/BACKTEST_RESULTS.md) validated this as a clean, broad-based
// improvement to drawdown control: max drawdown improved at ALL 10/10
// tickers (e.g. SPY -2.1%->-1.4%, TSLA -7.9%->-6.1%), median Sharpe
// 0.26->0.29, at a small, consistent CAGR cost (0.41%->0.39% median) -
// not a mixed bag like the chop filter, a uniform effect everywhere tested.
// riskPerTrade becomes a CEILING only reached at maximum conviction
// (net_score = +-100) rather than a flat amount every trade risks
// regardless of signal strength - a marginal entry right at its trigger
// threshold risks proportionally less.
useStrengthSizing = input.bool(true, "Scale Position Size by Signal Conviction (|net score| / 100)", group = grpRisk)

grpPopup = "Candle BUY/SELL % Popup"
showPopupAlert = input.bool(true, "Show BUY/SELL Popup Label When Score Crosses Threshold", group = grpPopup)
popupThreshold = input.int(50, "Popup Threshold (% net score, either direction)", minval = 1, maxval = 100, group = grpPopup)

grpPlanner = "Manual Trade Planner"
// Pine has no click-to-query interactivity (no way for a script to react to
// a specific mouse click on a bar) - the closest, more useful equivalent is
// "always live": a panel that continuously shows where stop/target/size
// would land if you entered RIGHT NOW, using the exact same ATR-based rules
// as the strategy's own real entries, so you never have to click anything -
// just glance at the chart whenever you're about to place a trade.
showTradePlanner = input.bool(true, "Show 'If You Enter Now' Stop/Target/Size Panel", group = grpPlanner)

grpUI = "Display"
showSignalButton = input.bool(true, "Show Big BUY/SELL Signal Button", group = grpUI)
showDashboard    = input.bool(true, "Show Detailed Data Panel", group = grpUI)
showBB           = input.bool(true, "Show Bollinger Bands", group = grpUI)

// ------------------------------- CORE SERIES ---------------------------------
emaFast = ta.ema(close, emaFastLen)
emaMid  = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)

rsi = ta.rsi(close, rsiLen)
[macdLine, macdSig, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)

obv = ta.obv
volSma = ta.sma(volume, relVolLen)

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

bbMid = ta.sma(close, bbLen)
bbDev = ta.stdev(close, bbLen)
bbUpper = bbMid + bbMult * bbDev
bbLower = bbMid - bbMult * bbDev
bbWidth = (bbUpper - bbLower) / bbMid

atrVal = ta.atr(atrLen)

ltSma = ta.sma(close, ltSmaLen)
momTotalBars = momSkipBars + momLookbackBars
momRecentClose = close[momSkipBars]
momPastClose = close[momTotalBars]
tsMomentum = momRecentClose / momPastClose - 1

// --------------------------- FACTOR 1: TREND (+/-20) ---------------------------
trendPts = 0.0
trendPts += close > emaFast ? 5 : -5
trendPts += emaFast > emaMid ? 5 : -5
trendPts += emaMid > emaSlow ? 5 : -5
trendPts += close > emaSlow ? 5 : -5

// -------------------------- FACTOR 2: MOMENTUM (+/-20) --------------------------
momentumPts = 0.0
momentumPts += rsi > 50 ? 5 : -5
momentumPts += rsi > rsi[1] ? 3 : -3
momentumPts += macdLine > macdSig ? 7 : -7
momentumPts += macdHist > macdHist[1] ? 5 : -5

// --------------------------- FACTOR 3: VOLUME (+/-15) ---------------------------
volumePts = 0.0
volumePts += obv > obv[obvLookback] ? 8 : -8
relVolSpike = volume > volSma * relVolMult
volumePts += relVolSpike ? (close > open ? 7 : close < open ? -7 : 0) : 0

// ----------------------- FACTOR 4: VOLATILITY REGIME (+/-10) --------------------
trending = adx > adxThresh
volaPts = 0.0
volaPts += trending ? (diPlus > diMinus ? 10 : -10) : 0.0

// ----------------------- FACTOR 5: MEAN-REVERSION / BB (+/-10) ------------------
bbPts = 0.0
breakoutUp   = close > bbUpper and bbWidth > bbWidth[1]
breakoutDown = close < bbLower and bbWidth > bbWidth[1]
bouncePotentialUp   = close <= bbLower and rsi < 30
bouncePotentialDown = close >= bbUpper and rsi > 70
bbPts += breakoutUp ? 10 : breakoutDown ? -10 : bouncePotentialUp ? 5 : bouncePotentialDown ? -5 : 0.0

// --------- FACTOR 6: LONG-TERM REGIME - SMA200 + 12-1mo Momentum (+/-25) --------
// See the header comment / docs/ARCHITECTURE.md for citations. This is the
// single largest-weighted factor because it's the one with the deepest,
// most-replicated academic evidence behind it, not because it's the
// "smartest" rule here.
longTermPts = 0.0
longTermPts += close > ltSma ? 12 : -12
longTermPts += tsMomentum > 0 ? 13 : -13

// ------------------------------ NET SCORE -------------------------------------
netScore = trendPts + momentumPts + volumePts + volaPts + bbPts + longTermPts

// ---------------------------- MULTI-TIMEFRAME FILTER --------------------------
[htfEmaFast, htfEmaSlow] = request.security(syminfo.tickerid, htfTF,
     [ta.ema(close, emaFastLen), ta.ema(close, emaSlowLen)], lookahead = barmerge.lookahead_off)
htfBullish = htfEmaFast > htfEmaSlow
htfBearish = htfEmaFast < htfEmaSlow

// ------------------------------ MARKET BREADTH ---------------------------------
// Same symbol's own timeframe (not a higher one), just a different ticker -
// SPY's own close vs its own 200-SMA, independent of whatever's on the chart.
[breadthClose, breadthSma] = request.security(breadthSymbol, timeframe.period,
     [close, ta.sma(close, ltSmaLen)], lookahead = barmerge.lookahead_off)
breadthBullish = breadthClose > breadthSma
breadthBearish = breadthClose < breadthSma

// ------------------------------ SIGNAL LOGIC -----------------------------------
// The BUY/SELL trigger event itself is tied to an EMA crossover (so the
// label pops up right on the candle where the crossover happens, matching
// what you'd see visually on the chart), gated by the confluence score
// already agreeing with that direction. Flip triggerMode to fall back to
// the older "score crosses its own threshold" behaviour.
isFastSlowPair = emaCrossPair == "Fast/Slow"
isMidSlowPair  = emaCrossPair == "Mid/Slow"

emaCrossUp = isMidSlowPair ? ta.crossover(emaMid, emaSlow) : isFastSlowPair ? ta.crossover(emaFast, emaSlow) : ta.crossover(emaFast, emaMid)
emaCrossDown = isMidSlowPair ? ta.crossunder(emaMid, emaSlow) : isFastSlowPair ? ta.crossunder(emaFast, emaSlow) : ta.crossunder(emaFast, emaMid)

useEmaCrossTrigger = triggerMode == "EMA Crossover + Confluence"

longTrigger  = useEmaCrossTrigger ? (emaCrossUp and netScore >= emaConfirmScore)    : ta.crossover(netScore, buyThreshold)
shortTrigger = useEmaCrossTrigger ? (emaCrossDown and netScore <= -emaConfirmScore) : ta.crossunder(netScore, sellThreshold)

// Regime gate: don't take a new short while the SMA200/12-1mo momentum
// regime is bullish, and vice versa for longs. Added after real-data
// backtesting showed the system taking near-equal long/short trades on
// SPY through an 11-year bull market (see docs/BACKTEST_RESULTS.md).
regimeBullish = longTermPts > 0
regimeBearish = longTermPts < 0

// Chop gate: don't take ANY new entry - long or short - while ADX says the
// market isn't trending at all. Complements the regime gate above: that one
// says "don't fight the big trend", this one says "don't trade when there's
// no trend to catch in the first place." `trending` is already computed for
// Factor 4 above.
chopOk = not useChopFilter or trending

// Breadth gate: don't take a new short on THIS ticker while the reference
// ticker (SPY by default) is itself in an uptrend, and vice versa for longs -
// distinct from the regime gate above, which only looks at this ticker's own
// trend. `breadthBullish`/`breadthBearish` computed above via request.security.
breadthOk_long  = not useBreadthFilter or breadthBullish
breadthOk_short = not useBreadthFilter or breadthBearish

longCondition  = longTrigger  and (not useHtfFilter or htfBullish) and (not useRegimeFilter or regimeBullish) and chopOk and breadthOk_long  and barstate.isconfirmed
shortCondition = shortTrigger and (not useHtfFilter or htfBearish) and (not useRegimeFilter or regimeBearish) and chopOk and breadthOk_short and barstate.isconfirmed

// When useStrengthSizing is on, riskPerTrade is only fully risked at max
// conviction (|netScore| = 100) - a marginal entry right at its trigger
// threshold risks proportionally less. See docs/ARCHITECTURE.md.
strengthMult = useStrengthSizing ? math.abs(netScore) / 100 : 1.0

longRiskDist  = atrVal * atrMultSL
shortRiskDist = atrVal * atrMultSL
longQty  = longRiskDist  > 0 ? (strategy.equity * riskPerTrade / 100 * strengthMult) / longRiskDist  : 0.0
shortQty = shortRiskDist > 0 ? (strategy.equity * riskPerTrade / 100 * strengthMult) / shortRiskDist : 0.0

// "If you enter now" hypothetical levels for the Manual Trade Planner below -
// same ATR-based formulas as the real entry blocks further down, just
// evaluated against the CURRENT close/ATR on every bar instead of only when
// an actual signal fires, so the answer is always on-screen, live.
plannerLongSL  = close - atrVal * atrMultSL
plannerLongTP  = close + atrVal * atrMultTP
plannerShortSL = close + atrVal * atrMultSL
plannerShortTP = close - atrVal * atrMultTP
plannerRiskDollars = strategy.equity * riskPerTrade / 100 * strengthMult
plannerRewardRisk = atrMultSL > 0 ? atrMultTP / atrMultSL : na

// Stop-loss / take-profit are locked in at the moment of entry (based on ATR
// *at that bar*) and held fixed until the trade closes - they do NOT
// recalculate every bar. This is what you'd actually place as resting
// stop/limit orders with your broker.
var float longSL  = na
var float longTP  = na
var float shortSL = na
var float shortTP = na

// alert() payloads below are JSON, not free text - built here so a webhook
// bot (3Commas, Alertatron, a custom receiver, etc.) can parse them directly
// instead of you having to regex a human-readable string. The on-chart
// labels are unaffected - still plain text, this only changes what the
// alert() calls send.
f_entryAlertJson(action, price, stop, target, qty, score) =>
    header = '{"strategy":"confluence_signal_system","ticker":"' + syminfo.ticker + '"'
    fields = ',"event":"entry"' + ',"action":"' + action + '"' + ',"price":' + str.tostring(price, format.mintick) + ',"stop":' + str.tostring(stop, format.mintick) + ',"target":' + str.tostring(target, format.mintick) + ',"qty":' + str.tostring(qty, "#.########") + ',"score":' + str.tostring(score, "#.0") + ',"time":' + str.tostring(time)
    header + fields + '}'

f_scoreAlertJson(direction, score, threshold, price) =>
    header = '{"strategy":"confluence_signal_system","ticker":"' + syminfo.ticker + '"'
    fields = ',"event":"score_alert"' + ',"direction":"' + direction + '"' + ',"score":' + str.tostring(score, "#.0") + ',"threshold":' + str.tostring(threshold) + ',"price":' + str.tostring(price, format.mintick) + ',"time":' + str.tostring(time)
    header + fields + '}'

if enableLong and longCondition and strategy.position_size <= 0
    if strategy.position_size < 0
        strategy.close("Short", comment = "Flip to Long")
    strategy.entry("Long", strategy.long, qty = longQty)
    longSL := close - atrVal * atrMultSL
    longTP := close + atrVal * atrMultTP
    label.new(bar_index, low, text = "BUY\nEntry " + str.tostring(close, format.mintick) +
         "\nSL " + str.tostring(longSL, format.mintick) + "\nTP " + str.tostring(longTP, format.mintick),
         style = label.style_label_up, color = color.new(color.green, 10), textcolor = color.white,
         size = size.small, yloc = yloc.belowbar)
    alert(f_entryAlertJson("buy", close, longSL, longTP, longQty, netScore), alert.freq_once_per_bar)

if enableShort and shortCondition and strategy.position_size >= 0
    if strategy.position_size > 0
        strategy.close("Long", comment = "Flip to Short")
    strategy.entry("Short", strategy.short, qty = shortQty)
    shortSL := close + atrVal * atrMultSL
    shortTP := close - atrVal * atrMultTP
    label.new(bar_index, high, text = "SELL\nEntry " + str.tostring(close, format.mintick) +
         "\nSL " + str.tostring(shortSL, format.mintick) + "\nTP " + str.tostring(shortTP, format.mintick),
         style = label.style_label_down, color = color.new(color.red, 10), textcolor = color.white,
         size = size.small, yloc = yloc.abovebar)
    alert(f_entryAlertJson("sell", close, shortSL, shortTP, shortQty, netScore), alert.freq_once_per_bar)

// ------------------------- CANDLE BUY/SELL % POPUP -----------------------------
// Independent of the strategy's own trade trigger above (which also requires
// an EMA crossover and only fires on a flat-to-entry transition) - this fires
// purely off net_score itself crossing +-popupThreshold, so you get a heads-up
// the moment conviction gets strong even on bars where the strategy isn't
// about to actually take a trade. Uses crossover/crossunder (not just "is
// score currently past the level") so it fires once per crossing event
// instead of re-labeling every single bar the score stays past the threshold.
popupBuyEvent  = ta.crossover(netScore, popupThreshold)
popupSellEvent = ta.crossunder(netScore, -popupThreshold)

if showPopupAlert and popupBuyEvent and barstate.isconfirmed
    label.new(bar_index, low, text = "BUY " + str.tostring(netScore, "#") + "%",
         style = label.style_label_up, color = color.new(color.teal, 15), textcolor = color.white,
         size = size.small, yloc = yloc.belowbar)
    alert(f_scoreAlertJson("bullish", netScore, popupThreshold, close), alert.freq_once_per_bar)

if showPopupAlert and popupSellEvent and barstate.isconfirmed
    label.new(bar_index, high, text = "SELL " + str.tostring(math.abs(netScore), "#") + "%",
         style = label.style_label_down, color = color.new(color.orange, 15), textcolor = color.white,
         size = size.small, yloc = yloc.abovebar)
    alert(f_scoreAlertJson("bearish", netScore, popupThreshold, close), alert.freq_once_per_bar)

alertcondition(popupBuyEvent,  title = "CSS Score Crossed Bullish Threshold", message = "Confluence Signal System: net score turned strongly BULLISH on {{ticker}} at {{close}}")
alertcondition(popupSellEvent, title = "CSS Score Crossed Bearish Threshold", message = "Confluence Signal System: net score turned strongly BEARISH on {{ticker}} at {{close}}")

if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", stop = longSL, limit = longTP)
    if netScore < exitLongScore and barstate.isconfirmed
        strategy.close("Long", comment = "Score Fade")

if strategy.position_size < 0
    strategy.exit("Short Exit", "Short", stop = shortSL, limit = shortTP)
    if netScore > exitShortScore and barstate.isconfirmed
        strategy.close("Short", comment = "Score Fade")

// Plotted SL/TP series: only visible while a position is actually open -
// derived from position_size rather than clearing longSL/shortSL directly,
// so the fixed levels stay intact for strategy.exit() on the fill bar
// (entries fill on the *next* bar, so position_size is still 0 on the
// signal bar itself).
slPlotSeries = strategy.position_size > 0 ? longSL : strategy.position_size < 0 ? shortSL : na
tpPlotSeries = strategy.position_size > 0 ? longTP : strategy.position_size < 0 ? shortTP : na

// -------------------------------- PLOTTING --------------------------------------
plot(emaFast, "EMA Fast", color = color.new(color.aqua, 0), linewidth = 1)
plot(emaMid,  "EMA Mid",  color = color.new(color.orange, 0), linewidth = 1)
plot(emaSlow, "EMA Slow", color = color.new(color.purple, 0), linewidth = 2)

bbUpperPlot = plot(showBB ? bbUpper : na, "BB Upper", color = color.new(color.gray, 60))
bbLowerPlot = plot(showBB ? bbLower : na, "BB Lower", color = color.new(color.gray, 60))
fill(bbUpperPlot, bbLowerPlot, color = color.new(color.gray, 92))

plotshape(longCondition,  title = "Buy Signal",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.lime, 0),  size = size.small)
plotshape(shortCondition, title = "Sell Signal", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),   size = size.small)

// Stop-loss / take-profit levels for the currently open trade, drawn as
// horizontal lines directly on the price chart - this is where to place
// your actual stop and limit orders. Lines disappear once the trade closes.
plot(slPlotSeries, title = "Stop Loss Level",   color = color.new(color.red, 0),   style = plot.style_linebr, linewidth = 2)
plot(tpPlotSeries, title = "Take Profit Level", color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 2)

bgColor = netScore >= strongBuyLevel ? color.new(color.lime, 88) :
     netScore >= buyThreshold ? color.new(color.green, 92) :
     netScore <= strongSellLevel ? color.new(color.red, 88) :
     netScore <= sellThreshold ? color.new(color.maroon, 92) : na
bgcolor(bgColor)

// ------------------------------- ALERTCONDITIONS ----------------------------------
alertcondition(longCondition,  title = "CSS Buy Signal",  message = "Confluence Signal System: BUY {{ticker}} at {{close}}")
alertcondition(shortCondition, title = "CSS Sell Signal", message = "Confluence Signal System: SELL {{ticker}} at {{close}}")

// ------------------------------ DASHBOARD DATA -------------------------------------
// Everything the two on-chart panels below display is computed here first as
// plain variables (not functions) and pre-formatted into text, to keep the
// panel-drawing code itself as simple as possible.

signalWord = netScore >= strongBuyLevel ? "STRONG BUY" : netScore >= buyThreshold ? "BUY" : netScore <= strongSellLevel ? "STRONG SELL" : netScore <= sellThreshold ? "SELL" : "NEUTRAL"
signalColor = netScore >= strongBuyLevel ? color.new(color.lime, 0) : netScore >= buyThreshold ? color.new(color.green, 0) : netScore <= strongSellLevel ? color.new(color.red, 0) : netScore <= sellThreshold ? color.new(color.maroon, 0) : color.new(color.gray, 20)
strengthPct = math.abs(netScore)
strengthText = str.tostring(strengthPct, "#") + "%"

positionText = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
positionColor = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.silver
entryPriceText = strategy.position_size != 0 ? str.tostring(strategy.position_avg_price, format.mintick) : "-"
slText = na(slPlotSeries) ? "-" : str.tostring(slPlotSeries, format.mintick)
tpText = na(tpPlotSeries) ? "-" : str.tostring(tpPlotSeries, format.mintick)
openPlPct = strategy.position_size != 0 ? (strategy.openprofit / (math.abs(strategy.position_size) * strategy.position_avg_price)) * 100 : na
openPlText = na(openPlPct) ? "-" : str.tostring(openPlPct, "#.00") + "%"
openPlColor = na(openPlPct) ? color.silver : openPlPct >= 0 ? color.lime : color.red

rsiText = na(rsi) ? "-" : str.tostring(rsi, "#.0")
macdHistText = na(macdHist) ? "-" : str.tostring(macdHist, "#.####")
adxText = na(adx) ? "-" : str.tostring(adx, "#.0")
relVolRatio = volSma != 0 ? volume / volSma : na
relVolText = na(relVolRatio) ? "-" : str.tostring(relVolRatio, "#.00") + "x"
atrText = na(atrVal) ? "-" : str.tostring(atrVal, format.mintick)
emaVsSlowPct = emaSlow != 0 ? (close - emaSlow) / emaSlow * 100 : na
emaVsSlowText = na(emaVsSlowPct) ? "-" : str.tostring(emaVsSlowPct, "#.00") + "%"
momText = na(tsMomentum) ? "-" : str.tostring(tsMomentum * 100, "#.0") + "%"
htfTrendText = htfBullish ? "BULLISH" : htfBearish ? "BEARISH" : "FLAT"
regimeText = regimeBullish ? "BULLISH" : regimeBearish ? "BEARISH" : "FLAT"
chopText = trending ? "TRENDING" : "CHOPPY"
breadthText = breadthBullish ? "BULLISH" : breadthBearish ? "BEARISH" : "FLAT"

closedTrades = strategy.closedtrades
winRatePct = closedTrades > 0 ? (strategy.wintrades / closedTrades) * 100 : na
winRateText = na(winRatePct) ? "-" : str.tostring(winRatePct, "#.0") + "%"
pfValue = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
pfText = na(pfValue) ? (strategy.grossprofit > 0 ? "Inf" : "-") : str.tostring(pfValue, "#.00")
netProfitPct = (strategy.netprofit / strategy.initial_capital) * 100
netProfitText = str.tostring(netProfitPct, "#.00") + "%"
netProfitColor = netProfitPct >= 0 ? color.lime : color.red
maxDDPct = (strategy.max_drawdown / strategy.initial_capital) * 100
maxDDText = str.tostring(maxDDPct, "#.00") + "%"

// ------------------------------- SIGNAL BUTTON --------------------------------------
// A big, hard-to-miss BUY/SELL/NEUTRAL readout at the top-center of the
// chart, with the signal strength shown as a percentage (0-100%, since the
// net score is already built on a 0-100 point budget per side).
var table signalBox = table.new(position.top_center, 1, 2, border_width = 2, frame_width = 2, frame_color = color.white)

if showSignalButton and barstate.islast
    table.cell(signalBox, 0, 0, signalWord, text_size = size.huge, text_color = color.white, bgcolor = signalColor)
    table.cell(signalBox, 0, 1, "STRENGTH " + strengthText, text_size = size.large, text_color = color.white, bgcolor = color.new(color.black, 20))

// --------------------------- DETAILED DATA PANEL -------------------------------------
var table dash = table.new(position.top_right, 2, 35, bgcolor = color.new(color.black, 20), border_width = 1)
sectionBg = color.new(color.blue, 60)

if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "Confluence Signal System", text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(dash, 1, 0, "", bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(dash, 0, 1, "Net Score", text_size = size.small)
    table.cell(dash, 1, 1, str.tostring(netScore, "#.0"), text_color = signalColor, text_size = size.small)
    table.cell(dash, 0, 2, "Regime", text_size = size.small)
    table.cell(dash, 1, 2, signalWord, text_color = signalColor, text_size = size.small)
    table.cell(dash, 0, 3, "Strength", text_size = size.small)
    table.cell(dash, 1, 3, strengthText, text_color = signalColor, text_size = size.small)

    table.cell(dash, 0, 4, "FACTOR BREAKDOWN", text_color = color.white, bgcolor = sectionBg, text_size = size.small)
    table.cell(dash, 1, 4, "", bgcolor = sectionBg, text_size = size.small)
    table.cell(dash, 0, 5, "Trend (+/-20)", text_size = size.small)
    table.cell(dash, 1, 5, str.tostring(trendPts, "#.0"), text_size = size.small)
    table.cell(dash, 0, 6, "Momentum (+/-20)", text_size = size.small)
    table.cell(dash, 1, 6, str.tostring(momentumPts, "#.0"), text_size = size.small)
    table.cell(dash, 0, 7, "Volume (+/-15)", text_size = size.small)
    table.cell(dash, 1, 7, str.tostring(volumePts, "#.0"), text_size = size.small)
    table.cell(dash, 0, 8, "Volatility (+/-10)", text_size = size.small)
    table.cell(dash, 1, 8, str.tostring(volaPts, "#.0"), text_size = size.small)
    table.cell(dash, 0, 9, "Mean-Rev (+/-10)", text_size = size.small)
    table.cell(dash, 1, 9, str.tostring(bbPts, "#.0"), text_size = size.small)
    table.cell(dash, 0, 10, "LT Regime (+/-25)", text_size = size.small)
    table.cell(dash, 1, 10, str.tostring(longTermPts, "#.0"), text_size = size.small)

    table.cell(dash, 0, 11, "LIVE INDICATORS", text_color = color.white, bgcolor = sectionBg, text_size = size.small)
    table.cell(dash, 1, 11, "", bgcolor = sectionBg, text_size = size.small)
    table.cell(dash, 0, 12, "RSI (14)", text_size = size.small)
    table.cell(dash, 1, 12, rsiText, text_size = size.small)
    table.cell(dash, 0, 13, "MACD Hist", text_size = size.small)
    table.cell(dash, 1, 13, macdHistText, text_size = size.small)
    table.cell(dash, 0, 14, "ADX", text_size = size.small)
    table.cell(dash, 1, 14, adxText, text_size = size.small)
    table.cell(dash, 0, 15, "Rel Volume", text_size = size.small)
    table.cell(dash, 1, 15, relVolText, text_size = size.small)
    table.cell(dash, 0, 16, "ATR", text_size = size.small)
    table.cell(dash, 1, 16, atrText, text_size = size.small)
    table.cell(dash, 0, 17, "Price vs EMA200", text_size = size.small)
    table.cell(dash, 1, 17, emaVsSlowText, text_size = size.small)
    table.cell(dash, 0, 18, "12-1mo Momentum", text_size = size.small)
    table.cell(dash, 1, 18, momText, text_size = size.small)
    table.cell(dash, 0, 19, "HTF Trend", text_size = size.small)
    table.cell(dash, 1, 19, htfTrendText, text_size = size.small)
    table.cell(dash, 0, 20, "Regime Filter", text_size = size.small)
    table.cell(dash, 1, 20, regimeText, text_size = size.small)
    table.cell(dash, 0, 21, "Chop Filter", text_size = size.small)
    table.cell(dash, 1, 21, chopText, text_size = size.small)
    table.cell(dash, 0, 22, "Breadth Filter", text_size = size.small)
    table.cell(dash, 1, 22, breadthText, text_size = size.small)

    table.cell(dash, 0, 23, "POSITION", text_color = color.white, bgcolor = sectionBg, text_size = size.small)
    table.cell(dash, 1, 23, "", bgcolor = sectionBg, text_size = size.small)
    table.cell(dash, 0, 24, "Position", text_size = size.small)
    table.cell(dash, 1, 24, positionText, text_color = positionColor, text_size = size.small)
    table.cell(dash, 0, 25, "Entry Price", text_size = size.small)
    table.cell(dash, 1, 25, entryPriceText, text_size = size.small)
    table.cell(dash, 0, 26, "Stop Loss", text_size = size.small)
    table.cell(dash, 1, 26, slText, text_color = color.red, text_size = size.small)
    table.cell(dash, 0, 27, "Take Profit", text_size = size.small)
    table.cell(dash, 1, 27, tpText, text_color = color.lime, text_size = size.small)
    table.cell(dash, 0, 28, "Open P/L", text_size = size.small)
    table.cell(dash, 1, 28, openPlText, text_color = openPlColor, text_size = size.small)

    table.cell(dash, 0, 29, "STRATEGY HISTORY (this chart)", text_color = color.white, bgcolor = sectionBg, text_size = size.small)
    table.cell(dash, 1, 29, "", bgcolor = sectionBg, text_size = size.small)
    table.cell(dash, 0, 30, "Closed Trades", text_size = size.small)
    table.cell(dash, 1, 30, str.tostring(closedTrades, "#"), text_size = size.small)
    table.cell(dash, 0, 31, "Win Rate", text_size = size.small)
    table.cell(dash, 1, 31, winRateText, text_size = size.small)
    table.cell(dash, 0, 32, "Profit Factor", text_size = size.small)
    table.cell(dash, 1, 32, pfText, text_size = size.small)
    table.cell(dash, 0, 33, "Net Profit", text_size = size.small)
    table.cell(dash, 1, 33, netProfitText, text_color = netProfitColor, text_size = size.small)
    table.cell(dash, 0, 34, "Max Drawdown", text_size = size.small)
    table.cell(dash, 1, 34, maxDDText, text_color = color.red, text_size = size.small)

// --------------------------- MANUAL TRADE PLANNER -------------------------------
// "If you enter now" - always live, no click needed. Same ATR-based stop/
// target/size formulas as the strategy's own real entries (see
// plannerLongSL/plannerLongTP/etc. computed earlier), just shown for
// whatever the current price is on the most recent bar, whether or not the
// strategy's own signal has actually fired here.
var table planner = table.new(position.bottom_right, 3, 7, bgcolor = color.new(color.black, 20), border_width = 1)

if showTradePlanner and barstate.islast
    table.cell(planner, 0, 0, "IF YOU ENTER NOW", text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(planner, 1, 0, "LONG", text_color = color.lime, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(planner, 2, 0, "SHORT", text_color = color.red, bgcolor = color.new(color.blue, 30), text_size = size.small)

    table.cell(planner, 0, 1, "Entry", text_size = size.small)
    table.cell(planner, 1, 1, str.tostring(close, format.mintick), text_size = size.small)
    table.cell(planner, 2, 1, str.tostring(close, format.mintick), text_size = size.small)

    table.cell(planner, 0, 2, "Stop Loss", text_size = size.small)
    table.cell(planner, 1, 2, str.tostring(plannerLongSL, format.mintick), text_color = color.red, text_size = size.small)
    table.cell(planner, 2, 2, str.tostring(plannerShortSL, format.mintick), text_color = color.red, text_size = size.small)

    table.cell(planner, 0, 3, "Take Profit", text_size = size.small)
    table.cell(planner, 1, 3, str.tostring(plannerLongTP, format.mintick), text_color = color.lime, text_size = size.small)
    table.cell(planner, 2, 3, str.tostring(plannerShortTP, format.mintick), text_color = color.lime, text_size = size.small)

    table.cell(planner, 0, 4, "Suggested Qty", text_size = size.small)
    table.cell(planner, 1, 4, str.tostring(longQty, "#.####"), text_size = size.small)
    table.cell(planner, 2, 4, str.tostring(shortQty, "#.####"), text_size = size.small)

    table.cell(planner, 0, 5, "Risk ($)", text_size = size.small)
    table.cell(planner, 1, 5, str.tostring(plannerRiskDollars, "#.00"), text_size = size.small)
    table.cell(planner, 2, 5, str.tostring(plannerRiskDollars, "#.00"), text_size = size.small)

    table.cell(planner, 0, 6, "Reward:Risk", text_size = size.small)
    table.cell(planner, 1, 6, str.tostring(plannerRewardRisk, "#.0") + ":1", text_size = size.small)
    table.cell(planner, 2, 6, str.tostring(plannerRewardRisk, "#.0") + ":1", text_size = size.small)

// Small markers on the current bar showing where the hypothetical stop/
// target would sit, only while flat (an open real position already draws
// its own solid SL/TP lines via slPlotSeries/tpPlotSeries above - this
// would just be visual clutter on top of those).
plannerActive = showTradePlanner and strategy.position_size == 0 and barstate.islast
plot(plannerActive ? plannerLongSL  : na, title = "Planner: Long Stop",    color = color.new(color.red,  40), style = plot.style_circles, linewidth = 3)
plot(plannerActive ? plannerLongTP  : na, title = "Planner: Long Target",  color = color.new(color.lime, 40), style = plot.style_circles, linewidth = 3)
plot(plannerActive ? plannerShortSL : na, title = "Planner: Short Stop",   color = color.new(color.red,  40), style = plot.style_circles, linewidth = 3)
plot(plannerActive ? plannerShortTP : na, title = "Planner: Short Target", color = color.new(color.lime, 40), style = plot.style_circles, linewidth = 3)
